# ──────────────────────────────────────────────────────────────
# Saiflow — environment variables template
# Copy to .env.local and fill in real values for local development.
# Authoritative schema: lib/env.ts (validated via @t3-oss/env-nextjs).
# These are placeholders — do NOT commit real secrets.
# ──────────────────────────────────────────────────────────────

# PostgreSQL connection string (Neon or other Postgres)
# Required for: all DB-dependent routes (/browse, /shop/*, /dashboard/*, product detail, orders)
# Get yours from: https://console.neon.tech/ (or your DB provider)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# NextAuth configuration
# Required for: all auth-gated routes (/dashboard/*)
# NEXTAUTH_URL: http://localhost:3000 for local dev, your domain in production
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Stripe — payments, checkout, and webhooks
# Required for: /api/checkout, /api/webhooks/stripe, the purchase flow
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"

# UploadThing — file hosting for digital products / thumbnails
# Required for: product file uploads
UPLOADTHING_TOKEN="your_uploadthing_token"

# Resend — transactional email (purchase receipts, password reset)
# Required for: email delivery after purchase, forgot/reset password
RESEND_API_KEY="re_your_resend_api_key"

# Google OAuth (optional — enables "Continue with Google" sign-in)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Pre-launch mode. When "true" (default), site shows pre-launch banner,
# checkout endpoint returns 503, BuyButton is disabled. Set to "false"
# only when Moyasar integration is live and ready for real transactions.
PRE_LAUNCH_MODE=true

# Optional: set to "true" to skip env validation (e.g. builds without full env)
# SKIP_ENV_VALIDATION=""

# Trust & Safety — comma-separated emails with moderation authority.
# Required for the /dashboard/moderation queue and approve/reject actions.
ADMIN_EMAILS="admin@example.com"

# ── AI Listing Assistant (v1) ────────────────────────────────────────
# Defaults OFF. The assistant is optional; product creation works without it.
AI_LISTING_ASSISTANT_ENABLED="false"
# Optional private-beta allowlist (admins are always allowed when enabled)
AI_LISTING_BETA_EMAILS=""
# Provider: "anthropic" | "openai" | "mock". Falls back to "mock" with no key.
AI_PROVIDER="mock"
AI_MODEL=""
AI_API_KEY=""
