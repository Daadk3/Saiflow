generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  password          String
  name              String?
  emailVerified     DateTime?
  image             String?
  resetToken        String?   @unique
  resetTokenExpiry  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  profile             Profile?
  hardwarePreferences HardwarePreference[]
  softwarePreferences SoftwarePreference[]
  ratingsGiven        Rating[]             @relation("RatingsGiven")
  ratingsReceived     Rating[]             @relation("RatingsReceived")
  shopUsers           ShopUser[]
  accounts            Account[]
  sessions            Session[]

  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  bio         String?  @db.Text
  location    String?
  website     String?
  phone       String?
  dateOfBirth DateTime?
  avatar      String?
  coverImage  String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model HardwarePreference {
  id          String   @id @default(cuid())
  userId      String
  category    String
  brand       String?
  model       String?
  specs       String?  @db.Text
  notes       String?  @db.Text
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
}

model SoftwarePreference {
  id          String   @id @default(cuid())
  userId      String
  category    String
  name        String
  version     String?
  licenseType String?
  notes       String?  @db.Text
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
}

model Shop {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  logo        String?
  coverImage  String?
  website     String?
  email       String?
  phone       String?
  address     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shopUsers  ShopUser[]
  products   Product[]
  fileAssets FileAsset[]

  @@index([slug])
  @@index([isActive])
  @@index([createdAt])
}

model ShopUser {
  id        String   @id @default(cuid())
  shopId    String
  userId    String
  role      ShopRole @default(MEMBER)
  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shopId, userId])
  @@index([shopId])
  @@index([userId])
}

enum ShopRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

model Product {
  id           String   @id @default(cuid())
  shopId       String
  name         String
  slug         String
  description  String?  @db.Text
  price        Decimal  @db.Decimal(10, 2)
  currency     String   @default("SAR")
  category     String?
  thumbnailUrl String?
  images       String[]
  fileUrl      String?
  /// Storage object key, ALWAYS derived server-side from fileUrl — never
  /// accepted from a client. This is the identity anchor for every
  /// file-safety decision: every upload mints a new key, so a replaced file
  /// cannot inherit the previous file's verdict.
  fileKey      String?
  isActive     Boolean  @default(true)
  isDigital    Boolean  @default(true)

  // Trust & Safety: publication requires APPROVED status. New uploads start
  // PENDING. Public visibility = isActive && moderationStatus == APPROVED.
  moderationStatus ModerationStatus @default(PENDING)
  // Timestamp of the seller's certification/legal-responsibility acceptance
  // (required at upload; enforced by the products API).
  certifiedAt      DateTime?

  // ---------------------------------------------------------------------
  // File safety. Written by the scanner from Stage C; the columns exist now
  // so the identity binding below is in place before any verdict can be.
  // ---------------------------------------------------------------------
  /// Verdict for the file identified by fileScanKey — NOT necessarily the
  /// file currently attached. Reading this field alone is always a bug.
  fileScanStatus   FileScanStatus @default(PENDING_SCAN)
  /// The key the verdict was issued for. The safety predicate is
  ///   fileScanStatus == SAFE && fileScanKey == fileKey && fileKey != null
  /// so a stale SAFE cannot survive a file replacement even if a future write
  /// path forgets to reset the status. Fail-closed by data shape.
  fileScanKey      String?
  /// SHA-256 computed by us over the bytes actually scanned. The storage
  /// provider's own hash is MD5, which is collision-attackable and so is
  /// never used as an identity check.
  fileScanSha256   String?
  fileScanAt       DateTime?
  /// Bounded-retry counter, persisted so a crash loop cannot reset it.
  fileScanAttempts Int            @default(0)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  shop             Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  ratings          Rating[]
  orders           Order[]
  paymentSessions  PaymentSession[]
  moderationEvents ModerationEvent[]

  @@unique([shopId, slug])
  @@index([shopId])
  @@index([slug])
  @@index([isActive])
  @@index([moderationStatus])
  @@index([category])
  @@index([createdAt])
  @@index([fileScanStatus])
}

/// Deliberately four states. QUARANTINED would behave identically to UNSAFE at
/// every gate; RETRYING is an attempt count, not a state; and EXPIRED /
/// SUPERSEDED cannot arise, because a superseded verdict is invalidated by the
/// fileScanKey != fileKey comparison rather than recorded as a status.
enum FileScanStatus {
  PENDING_SCAN
  SAFE
  UNSAFE
  SCAN_ERROR
}

/// Which upload route produced an object. Provenance is worthless without it:
/// a key uploaded as a shop logo must never be attachable as a deliverable.
enum UploadRoute {
  PRODUCT_FILE
  PRODUCT_THUMBNAIL
  SHOP_LOGO
  SHOP_COVER
}

/// Upload provenance: proof of who put an object in our storage, for which
/// shop, through which route — plus the scan verdict for its bytes.
///
/// This record is written ONLY by `onUploadComplete`, from middleware metadata
/// the server established itself. It is never created or amended from a client
/// payload, which is what makes it usable as an authorisation source.
///
/// It exists as its own model rather than as columns on Product because at
/// upload time no Product exists yet — the product is created afterwards by
/// POST /api/products. The scan verdict therefore has to live somewhere keyed
/// by the storage object, and Product copies it in at attach time.
model FileAsset {
  /// The UploadThing object key. Natural primary key: unique per upload, and
  /// the same value Product.fileKey binds to.
  key          String      @id
  shopId       String
  route        UploadRoute
  /// Recorded for audit, deliberately without a foreign key so that provenance
  /// outlives account deletion — the same convention ModerationEvent.actor uses.
  uploadedById String
  /// Client-declared metadata. Untrusted hints kept for triage only; the scan
  /// pipeline verifies the format from the bytes.
  name         String
  size         Int
  declaredType String

  scanStatus   FileScanStatus @default(PENDING_SCAN)
  /// SHA-256 over the exact bytes submitted to the scanner.
  scanSha256   String?
  scanAt       DateTime?
  /// Bounded-retry counter, persisted so a crash loop cannot reset it.
  scanAttempts Int            @default(0)
  /// Short reason category (e.g. "malware", "format_mismatch"). Never the
  /// provider's raw payload, and never file contents.
  scanReason   String?

  /// Lease held by the worker currently scanning this asset.
  ///
  /// Claiming is a single conditional UPDATE, so exactly one concurrent worker
  /// can take it; the losers see a row that no longer matches and stop before
  /// spending a provider call. The token is checked again at finalisation, so
  /// a worker whose lease expired and was taken over cannot write a verdict
  /// for bytes another worker has since re-scanned.
  scanClaimToken String?
  /// When the lease was taken. A worker that dies mid-scan would otherwise
  /// hold the asset forever, so a lease older than the timeout is reclaimable.
  scanClaimedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([scanStatus])
  @@index([route])
  @@index([createdAt])
  @@index([route, scanStatus])
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ModerationAction {
  SUBMITTED
  APPROVED
  REJECTED
  RESUBMITTED
  REPORTED
  /// An automated file-safety verdict. Never changes moderationStatus on its
  /// own — it records what the scanner concluded, and the gates read the
  /// scan columns rather than this event.
  SCANNED
}

// Append-only audit log of every moderation decision.
// Designed so Tier 1/2 (human queue, AI pipeline) plug in with NO schema
// changes: `actor` identifies who decided ("seller:<id>", "admin:<id>",
// "ai:<model>"), `categories` carries detected risk categories, and
// `confidence` carries AI confidence — both empty/null for manual actions.
model ModerationEvent {
  id         String           @id @default(cuid())
  productId  String
  action     ModerationAction
  actor      String
  reason     String?          @db.Text
  // Status transition audit: state before this event (null = product creation)
  // and after it. REPORTED events change nothing: both equal current status.
  previousStatus ModerationStatus?
  newStatus      ModerationStatus?
  categories String[]         @default([])
  confidence Float?
  createdAt  DateTime         @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([action])
  @@index([createdAt])
}

/// A CONFIRMED purchase, and nothing less.
///
/// A row exists only after a payment provider has proven the money moved: for
/// Stripe, a signature-verified webhook for a session already marked paid; for
/// Geidea, a signature-verified callback (or an authenticated order inquiry)
/// reporting the order paid. Every download is authorised on this row's
/// existence alone, so nothing pending, failed or unverified may ever be
/// written here. That is what PaymentSession is for.
model Order {
  id              String   @id @default(cuid())
  productId       String
  productName     String
  price           Decimal  @db.Decimal(10, 2)
  customerEmail   String
  /// Stripe's checkout session id. Nullable since Geidea, because a Geidea
  /// order has none. Kept, and still unique, so every existing Stripe row is
  /// unchanged and the dormant Stripe webhook still compiles and matches on it.
  stripeSessionId String?  @unique

  // ---------------------------------------------------------------------
  // Provider-agnostic payment identity, added with Geidea.
  //
  // Every default below exists ONLY so that rows written before these
  // columns existed, and the dormant Stripe route, describe themselves
  // truthfully without a change: those rows are Stripe, test, SAR. A new
  // write path must set all of these explicitly; a test pins that.
  // ---------------------------------------------------------------------
  paymentProvider     PaymentProvider    @default(STRIPE)
  /// The provider's own order id; for Geidea, `order.orderId`. Unique per
  /// provider: the idempotency key for fulfilment, so a callback delivered
  /// twice can create at most one Order.
  providerOrderId     String?
  /// SaiFlow's reference for the attempt that produced this order:
  /// PaymentSession.merchantReferenceId. Unique, so one attempt yields at
  /// most one Order.
  merchantReferenceId String?            @unique
  /// Which provider account took the money. TEST rows are never revenue.
  paymentEnvironment  PaymentEnvironment @default(TEST)
  currency            String             @default("SAR")
  createdAt       DateTime @default(now())

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// The attempt this order came from. Optional: Stripe rows have none, and
  /// SetNull so an attempt row can never take a purchase with it.
  paymentSession PaymentSession? @relation(fields: [merchantReferenceId], references: [merchantReferenceId], onDelete: SetNull)

  @@unique([paymentProvider, providerOrderId])
  @@index([productId])
  @@index([customerEmail])
  @@index([createdAt])
}

/// Which payment gateway a record belongs to. STRIPE is the dormant legacy
/// integration; GEIDEA is the KSA rail being integrated.
enum PaymentProvider {
  STRIPE
  GEIDEA
}

/// Which account of the provider took, or would take, the money. A column
/// rather than an inference from id prefixes: TEST rows are never counted as
/// revenue, and PRODUCTION is written only by a deployment whose GEIDEA_ENV
/// says so.
enum PaymentEnvironment {
  TEST
  PRODUCTION
}

/// The life of a payment attempt. Only PAID is terminal and good, and it is
/// written in the same transaction as the Order it proves, never before it.
///
///   CREATED          row inserted; the provider has not been asked for a session
///   SESSION_CREATED  the provider returned a session id; the buyer may be paying
///   PAID             a verified callback or inquiry said paid, and the Order exists
///   FAILED           the provider reported the payment failed
///   CANCELLED        the buyer abandoned the hosted page
///   EXPIRED          the session's lifetime (Geidea: 15 minutes) passed unpaid
enum PaymentSessionStatus {
  CREATED
  SESSION_CREATED
  PAID
  FAILED
  CANCELLED
  EXPIRED
}

/// A payment ATTEMPT, from the moment a buyer clicks Buy until the provider
/// has proven the outcome. It is not a purchase and must never be read as
/// one: nothing that grants access, whether a download, a receipt or a
/// revenue figure, may consult this table. Proof of purchase is an Order row,
/// and only the verified callback (or authenticated inquiry) that moves an
/// attempt to PAID may write one, in the same transaction.
///
/// WHY A SEPARATE TABLE rather than a status column on Order: every reader of
/// Order today treats existence as proof. A "pending order" would oblige each
/// of those readers to remember to check a status, and the one that forgets
/// becomes a free download. Keeping attempts in their own table means the
/// invariant holds by data shape, not by discipline.
///
/// WHAT IT IS FOR: the callback carries our merchantReferenceId and the
/// amount the provider charged. This row is where the intended product,
/// amount and currency were recorded BEFORE the redirect, so a callback is
/// checked against what SaiFlow meant to sell rather than against itself.
model PaymentSession {
  id                  String               @id @default(cuid())
  /// SaiFlow-generated UUID, sent to the provider as merchantReferenceId and
  /// echoed in every callback. The key an incoming callback is matched on.
  merchantReferenceId String               @unique
  provider            PaymentProvider
  /// The provider's session id (Geidea: `session.id`). Null until the
  /// provider has created the session.
  providerSessionId   String?
  /// The provider's order id (Geidea: `order.orderId`). Null until a callback
  /// or inquiry names one. Unique per provider, so one provider order maps to
  /// at most one attempt.
  providerOrderId     String?
  productId           String
  /// Snapshotted at attempt time in the repository's money representation,
  /// DECIMAL(10,2), the same as Product.price and Order.price. A callback
  /// whose amount or currency differs from these is a mismatch, not a sale.
  amount              Decimal              @db.Decimal(10, 2)
  currency            String
  /// Which provider account the attempt was created against (GEIDEA_ENV).
  environment         PaymentEnvironment
  status              PaymentSessionStatus @default(CREATED)
  /// The buyer's email when SaiFlow knows it at attempt time. Today's
  /// checkout is a guest flow that learns the email from the provider, so
  /// this is nullable, and there is no buyer user id because no checkout has
  /// a signed-in buyer.
  buyerEmail          String?
  /// The provider's last reported status string, short and verbatim
  /// ("Success", "Failed"). Diagnostic only, never an authority.
  providerStatus      String?
  /// Short reason category on FAILED, CANCELLED or EXPIRED. Never a raw
  /// provider payload, never buyer data.
  failureReason       String?
  callbackReceivedAt  DateTime?
  /// When the provider's session stops accepting payment (Geidea: 15 minutes
  /// after creation). A late callback is still verified on its own merits;
  /// this exists for expiring stale attempts and for support.
  expiresAt           DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// The Order this attempt produced once PAID. Absent for every other status.
  order   Order?

  @@unique([provider, providerSessionId])
  @@unique([provider, providerOrderId])
  @@index([productId])
  @@index([status])
  @@index([createdAt])
}

model Rating {
  id         String   @id @default(cuid())
  score      Int
  review     String?  @db.Text
  fromUserId String
  toUserId   String?
  productId  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  fromUser User     @relation("RatingsGiven", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User?    @relation("RatingsReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([fromUserId])
  @@index([toUserId])
  @@index([productId])
}
/// AI Listing Assistant — one row per generation attempt.
/// Powers durable per-user usage limits, auditability and quality measurement.
/// Deliberately NOT ModerationEvent: moderation decisions and AI generations
/// are different kinds of fact and must not share an audit trail.
/// Stores an input HASH, never the creator's raw text.
model AiGeneration {
  id            String   @id @default(cuid())
  userId        String
  shopId        String
  productId     String?
  provider      String
  model         String
  promptVersion String
  language      String
  status        AiGenerationStatus
  /// Which single section was regenerated, null for a full generation.
  section       String?
  /// SHA-256 of the creator input — enough to detect repeats, never the text.
  inputHash     String
  /// Validated structured suggestions. Never published; the creator applies
  /// fields manually through the ordinary form.
  output        Json?
  inputTokens   Int?
  outputTokens  Int?
  latencyMs     Int?
  errorCode     String?
  /// Compact field-level analytics: { accepted: [], edited: [], regenerated: [] }
  fieldEvents   Json?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([shopId])
  @@index([status])
}

enum AiGenerationStatus {
  SUCCEEDED
  FAILED
}
